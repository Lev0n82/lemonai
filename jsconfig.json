{
  "ignoreDeprecations": "6.0",
  "compilerOptions": {
    "paths": {
      "@src/*": [
        "./src/*"
      ],
      // Optional: set alias for type folders
      "@types/*": [
        "./types/*"
      ],
    },
    "checkJs": true,
    "target": "es2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0",
  },
  "include": [
    "**/*.js",
    "**/*.d.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}